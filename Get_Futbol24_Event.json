      "id": "a1b8aaba-7e56-4aed-aee8-6d3220546039",
      "name": "XML to Json"
    },
    {
      "parameters": {
        "jsCode": "// 取得輸入資料\nconst items = $input.all();\n\n// 展開所有比賽並只提取需要的欄位\nconst output = [];\nconst existingSheetNames = new Set(); // 用來追蹤已存在的 SheetName\n\nitems.forEach(item => {\n  const data = item.json;\n  \n  // Mecze 陣列\n  if (data.F24?.Mecze?.M && Array.isArray(data.F24.Mecze.M)) {\n    data.F24.Mecze.M.forEach(match => {\n      var eventTimeStamp = match.C0 || '';\n      const date = new Date((eventTimeStamp * 1000) + (8 * 60 * 60 * 1000));\n      const eventDate = date.toISOString().split('T')[0];\n      \n      // 只有在 SheetName 不存在時才添加\n      if (!existingSheetNames.has(eventDate)) {\n        existingSheetNames.add(eventDate);\n        output.push({\n          json: {\n            SheetName: eventDate\n          }\n        });\n      }\n    });\n  }\n});\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        416
      ],
      "id": "1c717e83-4386-459f-9300-64e6ae8a33f8",
      "name": "Extract Sheet Name"
    },
    {
      "parameters": {
        "jsCode": "// 取得輸入資料\nconst data = $('XML to Json').first().json;\n// 展開所有比賽並只提取需要的欄位\nconst output = [];\n\n// 建立 league ID 到完整 league info 的映射\nconst leagueMap = {};\nconst eventStatusMap = {};\n\nif (data.F24?.Kraje?.K && Array.isArray(data.F24.Kraje.K)) {\n  data.F24.Kraje.K.forEach(country => {\n    const countryName = country.KN || '';\n    \n    // 處理 L 可能是陣列或單一物件的情況\n    const leagues = Array.isArray(country.L) ? country.L : [country.L];\n    \n    leagues.forEach(league => {\n      if (league?.LId && league?.LN) {\n        // 儲存主聯賽資訊\n        leagueMap[league.LId] = {\n          country: countryName,\n          league: league.LN,\n          subLeague: ''\n        };\n        \n        // 處理子聯賽 (PL 可能是陣列或單一物件)\n        if (league.PL) {\n          const subLeagues = Array.isArray(league.PL) ? league.PL : [league.PL];\n          \n          subLeagues.forEach(subLeague => {\n            if (subLeague?.LId && subLeague?.LN) {\n              leagueMap[subLeague.LId] = {\n                country: countryName,\n                league: league.LN,\n                subLeague: subLeague.LN\n              };\n            }\n          });\n        }\n      }\n    });\n  });\n}\n\n// 建立 match ID 到 event status 的映射\nif (data.F24?.Zd?.Z && Array.isArray(data.F24.Zd.Z)) {\n  data.F24.Zd.Z.forEach(eventStatus => {\n    if (eventStatus.MId && eventStatus.CM && eventStatus.S) {\n      const matchId = eventStatus.MId;\n      const eventInfo = `${eventStatus.CM} [${eventStatus.S}]`;\n      \n      if (!eventStatusMap[matchId]) {\n        eventStatusMap[matchId] = '';\n      }\n      \n      if (eventStatusMap[matchId]) {\n        eventStatusMap[matchId] += ', ';\n      }\n      eventStatusMap[matchId] += eventInfo;\n    }\n  });\n}\n\n// 檢查並展開 Mecze 陣列\nif (data.F24?.Mecze?.M && Array.isArray(data.F24.Mecze.M)) {\n  data.F24.Mecze.M.forEach(match => {\n    var eventTimeStamp = match.C0 || '';\n    const date = new Date((eventTimeStamp * 1000) + (8 * 60 * 60 * 1000));\n    const eventDate = date.toISOString().split('T')[0];\n    const eventTime = date.toISOString().slice(0, 19).replace('T', ' ');\n    \n    // 優先使用 LId (子聯賽),如果沒有則使用 _LId (主聯賽)\n    const leagueId = match.LId || match._LId || '';\n    const leagueInfo = leagueMap[leagueId] || { country: '', league: '', subLeague: '' };\n    \n    output.push({\n      json: {\n        Cid: match.KId,\n        CName: leagueInfo.country || '',\n        MId: match.MId || '',\n        EventDate: eventDate,\n        EventTime: eventTime,\n        PLeagueId: match._LId,\n        LeagueId: match.LId,\n        PLeagueName: leagueInfo.league || \"\",\n        LeagueName: leagueInfo.subLeague || \"\",\n        HomeId: match.HId,\n        HomeName: match.HN || '',\n        AwayId: match.GId,\n        AwayName: match.GN || '',\n        EventStatus: eventStatusMap[match.MId] || '',\n        FScore: match.S1 || '',\n        HScore: match.S2 || '',\n        HRedCard: match.HRCi || '',\n        ARedCard: match.GRCi || '',\n      }\n    });\n  });\n}\n\n// 按照 EventDate 分組\nconst groupedByDate = {};\noutput.forEach(item => {\n  const eventDate = item.json.EventDate;\n  if (!groupedByDate[eventDate]) {\n    groupedByDate[eventDate] = [];\n  }\n  groupedByDate[eventDate].push(item);\n});\n\n// 將分組結果轉換為陣列格式\nconst finalOutput = Object.keys(groupedByDate).sort().map(date => ({\n  json: {\n    EventDate: date,\n    Matches: groupedByDate[date].map(item => item.json)\n  }\n}));\n\nreturn finalOutput;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
